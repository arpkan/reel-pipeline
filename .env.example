# AWS Bedrock — Claude Sonnet 5.5 (reel scripts + image-prompt name resolver)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional: Bedrock API key (bearer token). When set, it is used instead of the AWS credentials above.
BEDROCK_API_KEY=
# Optional: override the model (rollback: eu.anthropic.claude-sonnet-4-6). Use the eu./us. geo prefix matching AWS_REGION.
# BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-5-5
# Optional: low | medium | high (default low — keeps thinking tokens near zero)
# BEDROCK_EFFORT=low

# Google Cloud Storage (image + HTML upload)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GCS_BUCKET=

# Google Gen AI — Gemini Flash (discovery scoring) + image generation
GEMINI_API_KEY=
GEMINI_IMAGE_API_KEY=
# Image generation provider: gemini (default) | azure | azure+gemini
IMAGE_PROVIDER=gemini

# LLM provider switching for discovery + URL classification
# Values: gemini (default) | azure_gpt55
URL_CLASSIFIER_PROVIDER=gemini
DISCOVERY_PROVIDER=gemini

# Azure OpenAI / Foundry (used when provider is azure_gpt55)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_GPT55=gpt-5.5

# Tavily — news discovery + viral check
TAVILY_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_DS_CHAT_ID=
TELEGRAM_NS_CHAT_ID=
TELEGRAM_TS_CHAT_ID=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_DS_GROUP_ID=
LINE_NS_GROUP_ID=

# Meta Graph API
META_APP_ID=
META_APP_SECRET=
# Optional: takes precedence over META_APP_SECRET for the OAuth token exchange
# DS_META_APP_SECRET=
META_REDIRECT_URI=https://your-host/auth/meta/callback
DS_META_PAGE_ID=
DS_META_PAGE_TOKEN=
NS_META_PAGE_ID=
NS_META_PAGE_TOKEN=
TS_META_PAGE_ID=
TS_META_PAGE_TOKEN=

# TikTok (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional: defaults to ${PIPELINE_BASE_URL}/auth/tiktok/callback
# TIKTOK_REDIRECT_URI=
NS_TIKTOK_ACCESS_TOKEN=

# Free Stock Image APIs (optional — leave empty to skip stock layer, fallback to AI-generated)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Stock image provider priority — comma-separated, e.g. "unsplash,pexels,pixabay" (default).
# Override to test alternate orderings without code changes. Unknown names ignored.
STOCK_PROVIDER_ORDER=

# App
PIPELINE_PORT=3100
PIPELINE_DB_PATH=./data/pipeline.db
PIPELINE_BASE_URL=
# Dashboard access token (?token=...). Leave empty and the dashboard is open — set it in production.
DASHBOARD_SECRET=

# StoryReel personal video pipeline
STORYREEL_ENABLED=false
STORYREEL_GEMINI_MODEL=gemini-2.5-flash
# Dedicated Telegram bot for StoryReel, and the admin chat that approves results
STORYREEL_BOT_TOKEN=
STORYREEL_ADMIN_CHAT_ID=

# TTS — ElevenLabs
ELEVENLABS_API_KEY=
# ElevenLabs voice ID for the TS (German) brand
TS_REEL_VOICE_ID=

# TTS — uvoice (https://uvoice.app)
UVOICE_API_KEY=
DS_REEL_UVOICE_VOICE_ID=   # optional, defaults to EN-SailomSD
NS_REEL_UVOICE_VOICE_ID=   # optional, defaults to EN-SailomSD

# TTS — Minimax (https://minimax.io)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# TTS — Botnoi (https://voice.botnoi.ai/developer/api) — Thai voices, used by DS
BOTNOI_API_KEY=

# Whisper — local word timing for uvoice voices
# Model options: tiny (default), base, small, medium, large
WHISPER_MODEL=tiny

# C2PA signing (ES256 CA + leaf pair for embedding Google Imagen provenance into reels)
# C2PA_SIGN_CERT points to the leaf+CA chain; C2PA_SIGN_KEY to the leaf private key.
# The leaf cert must NOT be self-signed and must have emailProtection EKU + digitalSignature
# key usage, or c2pa-rs rejects it at sign time (see c2pa-rs certificate_profile.rs).
# To regenerate: see scripts/regen-c2pa-certs.sh
C2PA_SIGN_CERT=./keys/c2pa-signer-chain.pem
C2PA_SIGN_KEY=./keys/c2pa-signer-key.pem
